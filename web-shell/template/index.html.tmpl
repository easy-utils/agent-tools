<!DOCTYPE html>
<html lang="{{LANG}}">
<head>
  <meta charset="utf-8">{{HEAD_TOP}}
  <!-- viewport: NO `viewport-fit=cover`.
       The two runtimes size themselves differently — Flutter reads
       window.innerHeight/visualViewport, Compose measures its mount element —
       and NEITHER applies env(safe-area-inset-*).
       With `cover`, the layout viewport extends UNDER the Android gesture bar /
       iOS home indicator, so the bottom ~48px (composer + tab bar) were painted
       off-screen in an INSTALLED PWA (a browser TAB looked fine because its
       chrome lives outside the viewport). Without `cover` the OS insets the
       viewport for us and every engine lands inside the safe area automatically
       — no per-platform CSS.
       (`interactive-widget=resizes-content` keeps the viewport shrinking when
       the soft keyboard opens, so the composer stays above it.)
       NOTE: Flutter's engine deletes this meta and injects its own WITHOUT
       `cover` already, so this is a no-op there and the fix for the others. -->
  <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">{{HEAD_PRE}}
  <meta name="theme-color" content="{{THEME_COLOR}}">
  <meta name="description" content="{{DESCRIPTION}}">
  <link rel="icon" href="{{FAVICON}}" />
  <link rel="apple-touch-icon" href="{{APPLE_TOUCH_ICON}}" />{{MANIFEST_LINK}}
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="{{STATUS_BAR_STYLE}}">
  <meta name="apple-mobile-web-app-title" content="{{APP_TITLE}}">
  <title>{{APP_TITLE}}</title>
  <style>
    /* === GENERATED by tools/web-shell/gen.py — do not edit by hand. ===
       Shared web shell for the three EasyLab web clients (head, pre-boot splash,
       viewport). Per-app differences live in tools/web-shell/apps/<name>.json.
           python3 tools/web-shell/gen.py
           python3 tools/web-shell/gen.py --check   # drift guard */
    html, body { margin: 0; height: 100%; background: {{BG_COLOR}}; }
    @media (prefers-color-scheme: dark) { html, body { background: {{BG_COLOR_DARK}}; } }
    body { overflow: hidden; }{{ROOT_CSS}}

    /* Pre-boot splash: shown until the app paints its first frame, then removed
       by the app boot script. Mirrors the shared LoadingScreen in every client:
       client MARK + "Easy Agent" + a ring. */
    #agent-splash {
      position: fixed; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 16px;
      background: {{BG_COLOR}}; color: #1a1a1a;
      font-family: system-ui, -apple-system, 'Noto Sans SC', sans-serif;
    }
    @media (prefers-color-scheme: dark) { #agent-splash { background: {{BG_COLOR_DARK}}; color: #eeeeee; } }
    #agent-splash .mk {
      width: 40px; height: 40px; border-radius: 10px; background: {{MARK_COLOR}};
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 600; font-size: 16px;
      font-family: ui-monospace, 'Noto Sans Mono', monospace;
    }
    #agent-splash .ti { font-size: 14px; }
    #agent-splash .rg {
      width: 24px; height: 24px; border-radius: 50%;
      border: 2px solid currentColor; border-top-color: transparent;
      opacity: .55; animation: agent-spin .8s linear infinite;
    }
    @keyframes agent-spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div id="agent-splash">
    <div class="mk">{{MARK}}</div>
    <div class="ti">{{APP_TITLE}}</div>
    <div class="rg"></div>
  </div>
{{BODY}}
</body>
</html>
